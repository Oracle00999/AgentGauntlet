# Testnet only. Generate fresh local keys with npm run testnet:provision.
NEAR_OWNER_ID=
NEAR_OWNER_KEY=
NEAR_AGENT_ID=
NEAR_AGENT_KEY=
# Generated by npm run setup:agent; function-call-only key used by ShoppingBot.
NEAR_AGENT_PAYMENT_KEY=
NEAR_SUPPLIER_ID=
NEAR_SUPPLIER_KEY=
# Required for the subsequent ShoppingBot slice; never expose to frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# npm run setup:db creates these locally without printing secrets.
DATABASE_URL=
API_TOKEN=
PORT=3001

# npm run setup:web generates local workspace login/session secrets.
WEB_ACCESS_CODE=
WEB_SESSION_SECRET=
WEB_ORIGIN=http://127.0.0.1:3000
EXPRESS_API_ORIGIN=http://127.0.0.1:3001

# Optional operator-managed registry. npm run setup:targets creates a local example.
AG_TARGETS_FILE=
EXTERNAL_AGENT_TOKEN=
EXTERNAL_AGENT_PORT=3012
